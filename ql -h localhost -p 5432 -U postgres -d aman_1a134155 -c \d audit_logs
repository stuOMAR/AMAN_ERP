                                        Table "public.audit_logs"
    Column     |           Type           | Collation | Nullable |                Default                 
---------------+--------------------------+-----------+----------+----------------------------------------
 id            | integer                  |           | not null | nextval('audit_logs_id_seq'::regclass)
 tenant_id     | character varying(100)   |           |          | 
 user_id       | integer                  |           |          | 
 username      | character varying(100)   |           |          | 
 action        | character varying(100)   |           |          | 
 resource_type | character varying(50)    |           |          | 
 resource_id   | character varying(50)    |           |          | 
 details       | jsonb                    |           |          | 
 ip_address    | character varying(50)    |           |          | 
 branch_id     | integer                  |           |          | 
 is_archived   | boolean                  |           |          | false
 archived_at   | timestamp with time zone |           |          | 
 prev_hash     | character varying(64)    |           |          | 
 hash          | character varying(64)    |           |          | 
 chain_seq     | bigint                   |           |          | 
 created_at    | timestamp with time zone |           |          | CURRENT_TIMESTAMP
 critical      | boolean                  |           | not null | false
Indexes:
    "audit_logs_pkey" PRIMARY KEY, btree (id)
    "idx_audit_logs_archival" btree (created_at) WHERE is_archived = true
    "idx_audit_logs_branch" btree (branch_id)
    "idx_audit_logs_live" btree (created_at DESC) WHERE NOT is_archived
    "idx_audit_logs_user" btree (user_id)
    "idx_audit_resource" btree (resource_type, resource_id)
    "idx_audit_user_date" btree (user_id, created_at DESC)
    "ix_audit_logs_tenant_action_created" btree (tenant_id, action, created_at DESC)
    "ux_audit_logs_chain_seq" UNIQUE, btree (chain_seq)
Foreign-key constraints:
    "audit_logs_branch_id_fkey" FOREIGN KEY (branch_id) REFERENCES branches(id)
    "audit_logs_user_id_fkey" FOREIGN KEY (user_id) REFERENCES company_users(id) ON DELETE SET NULL
Triggers:
    audit_logs_no_delete BEFORE DELETE ON audit_logs FOR EACH ROW EXECUTE FUNCTION audit_logs_immutable_fn()
    audit_logs_no_update BEFORE UPDATE ON audit_logs FOR EACH ROW EXECUTE FUNCTION audit_logs_immutable_fn()

